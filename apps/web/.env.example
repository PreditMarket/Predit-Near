NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_API_BASE_URL="https://api.predit.market/api/v1"
# Cloudflare Worker that streams X videos (repo x-video-proxy). Unset = play
# them through the BE proxy (/api/v1/x-media/video) instead.
NEXT_PUBLIC_X_VIDEO_PROXY_URL=
# V2 (/v2 routes) defaults to the same host with /v1 → /v2. Only set this if
# V2 lives somewhere else.
# NEXT_PUBLIC_API_V2_BASE_URL="https://api.predit.market/api/v2"

# Privy (wallet/EVM/Solana + Google/X login) — see plan/privy-auth/privy-auth-fe-integration-status.md.
# Leave empty to disable Privy login in this env (the button no-ops with a toast).
NEXT_PUBLIC_PRIVY_APP_ID=""
# Only needed if Privy Dashboard's "Configure by client" is ON — otherwise
# wallet auth flows get rejected. Leave blank if that setting is off.
NEXT_PUBLIC_PRIVY_CLIENT_ID=""
# "true" once Solana gas sponsorship is enabled in the Privy dashboard: Privy
# then pays the SOL fee for trades sent from embedded (V2) wallets, which start
# with 0 SOL. Leave unset until then — sponsored sends are rejected otherwise.
NEXT_PUBLIC_PRIVY_SOLANA_SPONSOR=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The previous Predit (V1), linked from the sign-in so old accounts can claim their funds there. Unset hides the link.
NEXT_PUBLIC_V1_APP_URL=""

# TODO(security): NEXT_PUBLIC_ADMIN_EMAILS is exposed in client bundle — pre-existing issue, not resolved by migration.
NEXT_PUBLIC_ADMIN_EMAILS=

NEXT_PUBLIC_POLYMARKET_ENABLE=true
NEXT_PUBLIC_CLAIM_TOKEN_ENABLE=false
NEXT_PUBLIC_CLAIM_TOKEN_NETWORK=devnet
NEXT_PUBLIC_XP_TOKEN_MINT=""

NEXT_PUBLIC_PROOF_PORTAL_URL="https://dflow.net/proof"
NEXT_PUBLIC_PROOF_VERIFY_URL="https://proof.dflow.net/verify"

# Solana RPC endpoint. Pick the cluster here (devnet or mainnet RPC URL).
# Comma-separate multiple in NEXT_PUBLIC_RPC_URLS for failover.
NEXT_PUBLIC_RPC_URL=""
# Alias supported for rollout/canary envs that use Solana-prefixed names.
NEXT_PUBLIC_SOLANA_RPC_URL=""
NEXT_PUBLIC_SOLANA_WS_URL=""
# Canonical network switch for Solscan links + cluster-aware UI.
# devnet | testnet | mainnet-beta. If unset, auto-detected from RPC URL.
# Set this together with the matching NEXT_PUBLIC_PAMM_PROGRAM_ID below.
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
# TODO(security): NEXT_PUBLIC_CLIENT_TOKEN_SECRET is client-bundle-exposed — pre-existing exposure from VITE_CLIENT_TOKEN_SECRET, not resolved by migration.
NEXT_PUBLIC_CLIENT_TOKEN_SECRET=""

# Sentry (Phase 09 — add actual values then)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_ENABLE_SENTRY="false"
# SERVER-ONLY — do NOT prefix NEXT_PUBLIC_
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# pm-AMM prediction market
# Master kill-switch — set to "true" to enable PAMM UI, routes, and fetches.
# Anything else (missing, false, 0) leaves PAMM disabled.
NEXT_PUBLIC_PAMM_ENABLE=true


# Program id MUST match NEXT_PUBLIC_SOLANA_NETWORK / RPC cluster above.
# Devnet id shown; replace with the mainnet program id when going to mainnet.
NEXT_PUBLIC_PAMM_PROGRAM_ID=3qvm3mieTF53iUERTsavdY67eH4sfDxaphjQmHFhniod
NEXT_PUBLIC_PAMM_ADMIN_WALLETS=3STPNovRfBmURrmmZpCEPouGHkxhTyo8hFNfFpeMwGF7
NEXT_PUBLIC_PAMM_COLLATERAL_MINT=CmvDMgKkoGG6XdE3yYYtBCH5SXeX5n2hL68AL7xtrFvC
# Decimals for the XP/collateral token (NEXT_PUBLIC_PAMM_COLLATERAL_MINT). Defaults to 9.
NEXT_PUBLIC_XP_TOKEN_DECIMALS=9
NEXT_PUBLIC_PAMM_DEFAULT_CU_LIMIT=1400000
# Set to "true" to show the collateral token picker on the create-pool form; USDC is used by default when false.
NEXT_PUBLIC_PAMM_SHOW_COLLATERAL_SELECTOR=false
# Default initial liquidity L₀ in USDC for new pool creation forms. Defaults to 10000.
NEXT_PUBLIC_PAMM_DEFAULT_LIQUIDITY=10000

# PostHog — behavior analytics + bot/fake-user detection + PAMM rollout audit.
# See plans/260603-1758-posthog-integration/ for full integration plan.
# Phase 1: account + project setup. Phase 2 (next PR) wires the SDK.
# Project API key (public, prefix "phc_"). Leave empty to disable PostHog in this env.
NEXT_PUBLIC_POSTHOG_KEY=""
# Region host. US: https://us.i.posthog.com  ·  EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# NEAR hackathon. Server only: never prefix these with NEXT_PUBLIC_.
# Feed from twitterapi.io; without a key the feed shows sample posts.
TWITTER_API_KEY=
# Optional, comma separated X handles for the feed.
FEED_HANDLES=
# NEAR AI Cloud: detects predictions in posts and drafts markets. Without it the form is filled by hand.
NEAR_AI_API_KEY=
# Resolve agent. Runs inside the web server when the operator key is set; use a key limited to post_receipt and finalize.
NEAR_OPERATOR_ACCOUNT=
NEAR_OPERATOR_KEY=
# Comma separated NEAR accounts allowed to confirm results at /admin/resolve.
NEAR_ADMIN_ACCOUNTS=
# Where snapshots are kept; must survive restarts. Default .data/evidence.
EVIDENCE_DIR=
# Testnet account that sends new accounts 0.25 NEAR for gas.
NEAR_ONBOARD_ACCOUNT=
NEAR_ONBOARD_KEY=
# The mock USDC account and a function-call key limited to simulate_deposit.
NEAR_USDC_ACCOUNT=
NEAR_USDC_SIMULATE_KEY=
