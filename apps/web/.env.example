# Every variable is optional. With none set the app runs on NEAR testnet against the
# deployed demo contracts, shows sample posts, and leaves the NEAR AI features off.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# testnet (default) or mainnet. The contracts are only deployed on testnet.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_MARKET_CONTRACT=predit-markets-market.testnet
NEXT_PUBLIC_NEAR_USDC_CONTRACT=predit-markets-usdc.testnet

# Server only from here: never prefix these with NEXT_PUBLIC_.

# Live X feed from twitterapi.io. Without a key the feed shows sample posts.
TWITTER_API_KEY=
# Comma separated X handles for the feed.
FEED_HANDLES=

# NEAR AI Cloud (https://cloud.near.ai): finds predictions in posts, drafts markets,
# reads sources at expiry and answers Predit AI. Without it the create form is filled by hand.
NEAR_AI_API_KEY=

# Result agent. It runs inside the web server when the operator key is set.
# Use a function-call key limited to post_receipt and finalize.
NEAR_OPERATOR_ACCOUNT=
NEAR_OPERATOR_KEY=
# Comma separated NEAR accounts allowed to confirm results at /admin/resolve.
NEAR_ADMIN_ACCOUNTS=
# Where source snapshots and AI readings are kept; must survive restarts. Default .data/evidence.
EVIDENCE_DIR=
# Optional Jina Reader key for source snapshots; anonymous reads can be blocked per site.
JINA_API_KEY=

# Testnet account that gives new accounts 0.25 NEAR for gas.
NEAR_ONBOARD_ACCOUNT=
NEAR_ONBOARD_KEY=
# The mock USDC account and a function-call key limited to simulate_deposit.
NEAR_USDC_ACCOUNT=
NEAR_USDC_SIMULATE_KEY=

# Optional error reporting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENABLE_SENTRY=false
